      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "(100 * sum(rate(llamacpp:prompt_tokens_cached_total{instance=\"hlh-ai-engine-epu\"}[5m])) / clamp_min(sum(rate(llamacpp:prompt_tokens_total{instance=\"hlh-ai-engine-epu\"}[5m])) + sum(rate(llamacpp:prompt_tokens_cached_total{instance=\"hlh-ai-engine-epu\"}[5m])), 0.0001))",
