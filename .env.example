# Stage 0 — copy to .env and set secrets before Stage 1 --apply
# Grafana admin (provisioned on first start, stored in grafana_data)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me

# Prometheus retention override (default 15d in compose command)
# PROM_RETENTION=15d

# Macvlan service IP (locked per plan)
MONITOR_IP=192.168.1.14
MACVLAN_NAME=macvlan
MACVLAN_PARENT=eth0
MACVLAN_SUBNET=192.168.1.0/24
MACVLAN_GATEWAY=192.168.1.1

# Scrape targets (override if engines move)
VLLM_TARGET=192.168.1.13:8000
LLAMACPP_TARGET=192.168.1.12:80
