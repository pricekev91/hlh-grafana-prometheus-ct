# Stage 1 — copy to .env and set the password before --apply
# (GF_SECURITY_ADMIN_PASSWORD is only applied on first start of a FRESH
#  grafana_data; afterwards change the password in the Grafana UI.)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me

# Prometheus retention override (default 15d in docker-compose.yml)
# PROM_RETENTION=15d

# Macvlan (grafana's dedicated IP — the grafana.mizertech.net target)
MONITOR_IP=192.168.1.14
MACVLAN_NAME=macvlan
MACVLAN_PARENT=eth0
MACVLAN_SUBNET=192.168.1.0/24
MACVLAN_GATEWAY=192.168.1.1

# Scrape targets (informational — prometheus.yml is static; edit it if engines move)
LLAMACPP_TARGET=192.168.1.12:80
LLAMACPP_EPU_TARGET=192.168.1.11:80
